//@version=6
indicator("HarmonyTrading Professional Direction Engine V4.0-C", overlay=true, max_bars_back=1000, max_labels_count=100)

//====================================================================
// HARMONYTRADING — V4.0-C
// MARKET-STRUCTURE-FIRST DIRECTION ENGINE
//
// Daily = strategic context
// 4H = primary direction
// Local chart structure = execution confirmation
//
// This version intentionally contains NO 5M level engine and
// NO Order Assessor.
// Those are added only after the direction engine is validated.
//====================================================================


//====================================================================
// INPUTS
//====================================================================

string G_STRUCTURE = "01 — Structure"
string G_VISUAL = "02 — Visuals"

string dailyTF = input.timeframe("D", "Daily timeframe", group=G_STRUCTURE)
string fourHourTF = input.timeframe("240", "4H timeframe", group=G_STRUCTURE)

int pivotLength = input.int(
     5,
     "Structure pivot length",
     minval=2,
     maxval=20,
     group=G_STRUCTURE)

int emaLength = input.int(
     200,
     "EMA length",
     minval=20,
     maxval=500,
     group=G_STRUCTURE)

int eventWindow = input.int(
     16,
     "Local event window",
     minval=6,
     maxval=50,
     group=G_STRUCTURE)

int minimumEvents = input.int(
     4,
     "Minimum local events",
     minval=2,
     maxval=20,
     group=G_STRUCTURE)

int minimumSameSide = input.int(
     3,
     "Minimum same-side events",
     minval=2,
     maxval=15,
     group=G_STRUCTURE)

bool requireFourHourStructure = input.bool(
     true,
     "Require 4H structure alignment",
     group=G_STRUCTURE)

bool requireFourHourEMA = input.bool(
     true,
     "Require 4H EMA alignment",
     group=G_STRUCTURE)

bool requireDailyAgreement = input.bool(
     false,
     "Require Daily agreement",
     group=G_STRUCTURE)

bool showEMA = input.bool(
     true,
     "Show 200 EMA",
     group=G_VISUAL)

bool showStructureLabels = input.bool(
     true,
     "Show HH / HL / LH / LL",
     group=G_VISUAL)

bool showDirectionLine = input.bool(
     true,
     "Show direction line",
     group=G_VISUAL)

bool showDashboard = input.bool(
     true,
     "Show dashboard",
     group=G_VISUAL)


//====================================================================
// CONSTANTS
//====================================================================

int TRANSITION = 0
int BULLISH = 1
int BEARISH = -1


//====================================================================
// LOCAL STRUCTURE
//====================================================================

float localPivotHigh = ta.pivothigh(
     high,
     pivotLength,
     pivotLength)

float localPivotLow = ta.pivotlow(
     low,
     pivotLength,
     pivotLength)

var float previousLocalHigh = na
var float latestLocalHigh = na

var float previousLocalLow = na
var float latestLocalLow = na

var int localHighState = TRANSITION
var int localLowState = TRANSITION

bool newHH = false
bool newLH = false
bool newHL = false
bool newLL = false


//====================================================================
// HIGH STRUCTURE
//====================================================================

if not na(localPivotHigh)

    previousLocalHigh := latestLocalHigh
    latestLocalHigh := localPivotHigh

    if not na(previousLocalHigh)

        if latestLocalHigh > previousLocalHigh

            localHighState := BULLISH
            newHH := true

        else if latestLocalHigh < previousLocalHigh

            localHighState := BEARISH
            newLH := true

        else

            localHighState := TRANSITION


//====================================================================
// LOW STRUCTURE
//====================================================================

if not na(localPivotLow)

    previousLocalLow := latestLocalLow
    latestLocalLow := localPivotLow

    if not na(previousLocalLow)

        if latestLocalLow > previousLocalLow

            localLowState := BULLISH
            newHL := true

        else if latestLocalLow < previousLocalLow

            localLowState := BEARISH
            newLL := true

        else

            localLowState := TRANSITION


//====================================================================
// LOCAL EVENT SEQUENCE
//
// +1 = bullish event
//      HH or HL
//
// -1 = bearish event
//      LH or LL
//====================================================================

var array<int> localEvents = array.new_int()

if newHH
    array.push(localEvents, 1)

if newHL
    array.push(localEvents, 1)

if newLH
    array.push(localEvents, -1)

if newLL
    array.push(localEvents, -1)

while array.size(localEvents) > eventWindow
    array.shift(localEvents)

int localEventCount = array.size(localEvents)

int bullishEventCount = 0
int bearishEventCount = 0


//====================================================================
// COUNT LOCAL EVENTS
//====================================================================

if localEventCount > 0

    for i = 0 to localEventCount - 1

        int eventValue = array.get(
             localEvents,
             i)

        if eventValue == 1

            bullishEventCount += 1

        else if eventValue == -1

            bearishEventCount += 1


//====================================================================
// SEQUENCE DIRECTION
//====================================================================

bool bullishSequence = bullishEventCount > bearishEventCount

bool bearishSequence = bearishEventCount > bullishEventCount


//====================================================================
// LOCAL STRUCTURAL STATES
//====================================================================

bool localBullishStructure =
     localHighState == BULLISH and
     localLowState == BULLISH

bool localBearishStructure =
     localHighState == BEARISH and
     localLowState == BEARISH


//====================================================================
// LOCAL STRUCTURE GATES
//====================================================================

bool bullishLocalGate = false
bool bearishLocalGate = false


if localBullishStructure

    if bullishSequence

        if localEventCount >= minimumEvents

            if bullishEventCount >= minimumSameSide

                bullishLocalGate := true


if localBearishStructure

    if bearishSequence

        if localEventCount >= minimumEvents

            if bearishEventCount >= minimumSameSide

                bearishLocalGate := true


//====================================================================
// LOCAL 200 EMA
//====================================================================

float localEMA = ta.ema(
     close,
     emaLength)


//====================================================================
// HIGHER-TIMEFRAME STRUCTURE FUNCTIONS
//
// These functions deliberately return one simple integer.
// This avoids the tuple-return architecture that caused previous
// parser/compiler problems.
//====================================================================

f_highRelation(int pLen) =>

    float ph = ta.pivothigh(
         high,
         pLen,
         pLen)

    var float previousHigh = na
    var float latestHigh = na

    var int relation = 0

    if not na(ph)

        previousHigh := latestHigh
        latestHigh := ph

        if not na(previousHigh)

            if latestHigh > previousHigh

                relation := 1

            else if latestHigh < previousHigh

                relation := -1

            else

                relation := 0

    relation


//====================================================================
// LOW RELATION FUNCTION
//====================================================================

f_lowRelation(int pLen) =>

    float pl = ta.pivotlow(
         low,
         pLen,
         pLen)

    var float previousLow = na
    var float latestLow = na

    var int relation = 0

    if not na(pl)

        previousLow := latestLow
        latestLow := pl

        if not na(previousLow)

            if latestLow > previousLow

                relation := 1

            else if latestLow < previousLow

                relation := -1

            else

                relation := 0

    relation


//====================================================================
// EMA STATE FUNCTION
//====================================================================

f_emaState(int eLen) =>

    float emaValue = ta.ema(
         close,
         eLen)

    int state = 0

    if close > emaValue

        state := 1

    else if close < emaValue

        state := -1

    state


//====================================================================
// DAILY CONFIRMED STRUCTURE
//
// Previous completed Daily bar is used.
// lookahead_on is paired with [1] to prevent using the currently
// forming Daily bar.
//====================================================================

int dailyHighState =
     request.security(
         syminfo.tickerid,
         dailyTF,
         f_highRelation(pivotLength)[1],
         lookahead=barmerge.lookahead_on)

int dailyLowState =
     request.security(
         syminfo.tickerid,
         dailyTF,
         f_lowRelation(pivotLength)[1],
         lookahead=barmerge.lookahead_on)

int dailyEMAState =
     request.security(
         syminfo.tickerid,
         dailyTF,
         f_emaState(emaLength)[1],
         lookahead=barmerge.lookahead_on)


//====================================================================
// DAILY STRUCTURE STATE
//====================================================================

bool dailyBullish =
     dailyHighState == BULLISH and
     dailyLowState == BULLISH

bool dailyBearish =
     dailyHighState == BEARISH and
     dailyLowState == BEARISH


//====================================================================
// 4H CONFIRMED STRUCTURE
//====================================================================

int fourHourHighState =
     request.security(
         syminfo.tickerid,
         fourHourTF,
         f_highRelation(pivotLength)[1],
         lookahead=barmerge.lookahead_on)

int fourHourLowState =
     request.security(
         syminfo.tickerid,
         fourHourTF,
         f_lowRelation(pivotLength)[1],
         lookahead=barmerge.lookahead_on)

int fourHourEMAState =
     request.security(
         syminfo.tickerid,
         fourHourTF,
         f_emaState(emaLength)[1],
         lookahead=barmerge.lookahead_on)


//====================================================================
// 4H STRUCTURE STATE
//====================================================================

bool fourHourBullish =
     fourHourHighState == BULLISH and
     fourHourLowState == BULLISH

bool fourHourBearish =
     fourHourHighState == BEARISH and
     fourHourLowState == BEARISH


//====================================================================
// 4H STRUCTURE GATES
//====================================================================

bool bullishFourHourGate = true
bool bearishFourHourGate = true

if requireFourHourStructure

    bullishFourHourGate := fourHourBullish
    bearishFourHourGate := fourHourBearish


//====================================================================
// 4H EMA GATES
//====================================================================

bool bullishEMAGate = true
bool bearishEMAGate = true

if requireFourHourEMA

    bullishEMAGate :=
         fourHourEMAState == BULLISH

    bearishEMAGate :=
         fourHourEMAState == BEARISH


//====================================================================
// DAILY GATES
//====================================================================

bool bullishDailyGate = true
bool bearishDailyGate = true

if requireDailyAgreement

    bullishDailyGate := dailyBullish
    bearishDailyGate := dailyBearish


//====================================================================
// FINAL DIRECTION READINESS
//====================================================================

bool bullishReady = false
bool bearishReady = false


//====================================================================
// BULLISH READINESS
//====================================================================

if bullishLocalGate

    if bullishFourHourGate

        if bullishEMAGate

            if bullishDailyGate

                bullishReady := true


//====================================================================
// BEARISH READINESS
//====================================================================

if bearishLocalGate

    if bearishFourHourGate

        if bearishEMAGate

            if bearishDailyGate

                bearishReady := true


//====================================================================
// FINAL DIRECTION STATE
//====================================================================

int directionState = TRANSITION

if bullishReady and not bearishReady

    directionState := BULLISH

else if bearishReady and not bullishReady

    directionState := BEARISH


//====================================================================
// DIRECTION CONFIDENCE
//
// Informational only.
// Structural gates determine the actual direction.
//====================================================================

float directionConfidence = 0.0


//====================================================================
// BULLISH CONFIDENCE
//====================================================================

if directionState == BULLISH

    float localPart = 0.0
    float fourHourPart = 0.0
    float emaPart = 0.0
    float dailyPart = 0.0

    if bullishEventCount > bearishEventCount

        localPart := 25.0

    if fourHourBullish

        fourHourPart := 35.0

    if fourHourEMAState == BULLISH

        emaPart := 25.0

    if dailyBullish

        dailyPart := 15.0

    directionConfidence :=
         localPart +
         fourHourPart +
         emaPart +
         dailyPart


//====================================================================
// BEARISH CONFIDENCE
//====================================================================

else if directionState == BEARISH

    float localPart = 0.0
    float fourHourPart = 0.0
    float emaPart = 0.0
    float dailyPart = 0.0

    if bearishEventCount > bullishEventCount

        localPart := 25.0

    if fourHourBearish

        fourHourPart := 35.0

    if fourHourEMAState == BEARISH

        emaPart := 25.0

    if dailyBearish

        dailyPart := 15.0

    directionConfidence :=
         localPart +
         fourHourPart +
         emaPart +
         dailyPart


//====================================================================
// DISPLAY TEXT
//====================================================================

string directionText = "TRANSITION"

if directionState == BULLISH

    directionText := "BULLISH"

else if directionState == BEARISH

    directionText := "BEARISH"


string structureText = "MIXED"

if localBullishStructure

    structureText := "HH + HL"

else if localBearishStructure

    structureText := "LH + LL"


string sequenceText = "MIXED"

if bullishSequence

    sequenceText := "BULLISH SEQUENCE"

else if bearishSequence

    sequenceText := "BEARISH SEQUENCE"


string dailyText = "MIXED"

if dailyBullish

    dailyText := "BULLISH"

else if dailyBearish

    dailyText := "BEARISH"


string fourHourText = "MIXED"

if fourHourBullish

    fourHourText := "BULLISH"

else if fourHourBearish

    fourHourText := "BEARISH"


string emaText = "NEUTRAL"

if fourHourEMAState == BULLISH

    emaText := "BULLISH"

else if fourHourEMAState == BEARISH

    emaText := "BEARISH"


string setupText = "NO ACTIVE SETUP"

if directionState == BULLISH

    setupText := "LONG DIRECTION CONFIRMED"

else if directionState == BEARISH

    setupText := "SHORT DIRECTION CONFIRMED"


//====================================================================
// 200 EMA VISUAL
//====================================================================

plot(
     showEMA ? localEMA : na,
     title="200 EMA",
     color=color.orange,
     linewidth=2)


//====================================================================
// STRUCTURE LABELS
//====================================================================

plotshape(
     showStructureLabels and newHH,
     title="HH",
     style=shape.labeldown,
     location=location.abovebar,
     offset=-pivotLength,
     color=color.green,
     textcolor=color.white,
     size=size.tiny,
     text="HH")

plotshape(
     showStructureLabels and newHL,
     title="HL",
     style=shape.labelup,
     location=location.belowbar,
     offset=-pivotLength,
     color=color.green,
     textcolor=color.white,
     size=size.tiny,
     text="HL")

plotshape(
     showStructureLabels and newLH,
     title="LH",
     style=shape.labeldown,
     location=location.abovebar,
     offset=-pivotLength,
     color=color.red,
     textcolor=color.white,
     size=size.tiny,
     text="LH")

plotshape(
     showStructureLabels and newLL,
     title="LL",
     style=shape.labelup,
     location=location.belowbar,
     offset=-pivotLength,
     color=color.red,
     textcolor=color.white,
     size=size.tiny,
     text="LL")


//====================================================================
// DIRECTION STATE LINE
//
// Green  = bullish
// Red    = bearish
// Orange = transition
//====================================================================

float directionATR = ta.atr(14)

float directionLinePrice = close

if directionState == BULLISH

    directionLinePrice :=
         high + directionATR * 0.65

else if directionState == BEARISH

    directionLinePrice :=
         low - directionATR * 0.65


color directionLineColor = color.orange

if directionState == BULLISH

    directionLineColor := color.lime

else if directionState == BEARISH

    directionLineColor := color.red


plot(
     showDirectionLine ? directionLinePrice : na,
     title="Direction State",
     color=directionLineColor,
     linewidth=3,
     style=plot.style_linebr)


//====================================================================
// DASHBOARD
//====================================================================

var table dashboard =
     table.new(
         position.top_right,
         2,
         10,
         bgcolor=color.new(color.black, 10),
         frame_color=color.gray,
         frame_width=1,
         border_color=color.gray,
         border_width=1)


if barstate.islast and showDashboard

    table.cell(
         dashboard,
         0,
         0,
         "HARMONYTRADING",
         text_color=color.white,
         bgcolor=color.new(color.blue, 40))

    table.cell(
         dashboard,
         1,
         0,
         "V4.0-C",
         text_color=color.white,
         bgcolor=color.new(color.blue, 40))

    table.cell(
         dashboard,
         0,
         1,
         "DIRECTION",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         1,
         directionText,
         text_color=color.white)

    table.cell(
         dashboard,
         0,
         2,
         "DAILY",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         2,
         dailyText,
         text_color=color.white)

    table.cell(
         dashboard,
         0,
         3,
         "4H STRUCTURE",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         3,
         fourHourText,
         text_color=color.white)

    table.cell(
         dashboard,
         0,
         4,
         "4H EMA",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         4,
         emaText,
         text_color=color.white)

    table.cell(
         dashboard,
         0,
         5,
         "LOCAL STRUCTURE",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         5,
         structureText,
         text_color=color.white)

    table.cell(
         dashboard,
         0,
         6,
         "LOCAL SEQUENCE",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         6,
         sequenceText,
         text_color=color.white)

    table.cell(
         dashboard,
         0,
         7,
         "EVENTS",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         7,
         str.tostring(localEventCount) +
         " / " +
         str.tostring(bullishEventCount) +
         " B / " +
         str.tostring(bearishEventCount) +
         " S",
         text_color=color.white)

    table.cell(
         dashboard,
         0,
         8,
         "CONFIDENCE",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         8,
         str.tostring(
             directionConfidence,
             "#.0") +
         "%",
         text_color=color.white)

    table.cell(
         dashboard,
         0,
         9,
         "SETUP",
         text_color=color.white)

    table.cell(
         dashboard,
         1,
         9,
         setupText,
         text_color=color.white)


//====================================================================
// ALERTS
//====================================================================

bool newBullishDirection =
     directionState == BULLISH and
     directionState[1] != BULLISH

bool newBearishDirection =
     directionState == BEARISH and
     directionState[1] != BEARISH

bool newTransition =
     directionState == TRANSITION and
     directionState[1] != TRANSITION


alertcondition(
     newBullishDirection,
     title="HarmonyTrading Bullish Direction",
     message="HarmonyTrading V4.0-C: Bullish direction confirmed. Review 5M support separately.")

alertcondition(
     newBearishDirection,
     title="HarmonyTrading Bearish Direction",
     message="HarmonyTrading V4.0-C: Bearish direction confirmed. Review 5M resistance separately.")

alertcondition(
     newTransition,
     title="HarmonyTrading Transition",
     message="HarmonyTrading V4.0-C: Market structure is in transition. No active directional setup.")
